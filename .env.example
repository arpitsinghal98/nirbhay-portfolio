# Copy to .env.local and add your key there. Never use NEXT_PUBLIC_ for secrets.
# Vercel deployments can alternatively authenticate with VERCEL_OIDC_TOKEN.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5.6-luna
# Set to the final canonical origin before deploying (no trailing slash).
SITE_URL=http://localhost:3000
